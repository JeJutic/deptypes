-- 1. Докажите, что add x (add x s) = add x s и add x (add y s) = add y (add x s)

\func add-idemp {S : SetSpec} (x : S.A) (s : S) : add x (add x s) = add x s =>
  S.set-ext (\lam _ => (
    \lam i => \case S.add-prop i \with {
      | byLeft x=a => transport (S.isElem __ (add x s)) x=a S.add-head
      | byRight b => b
    },
    \lam i => S.add-tail i
  ))

\func add-swap {S : SetSpec} (x y : S.A) (s : S) : add x (add y s) = add y (add x s) =>
  S.set-ext (\lam a => (uni-swap x y a, uni-swap y x a))
  \where {
    \func uni-swap (x1 y1 : S.A) (a : S.A) : a S.`isElem` add x1 (add y1 s) -> a S.`isElem` add y1 (add x1 s) =>
      \lam i => \case S.add-prop i \with {
        | byLeft x1=a => transport (S.isElem __ (add y1 (add x1 s))) x1=a (S.add-tail S.add-head)
        | byRight a_in_y1+s => \case S.add-prop a_in_y1+s \with {
          | byLeft y1=a => transport (S.isElem __ (add y1 (add x1 s))) y1=a S.add-head
          | byRight a_in_s => S.add-tail (S.add-tail a_in_s)
        }
      }
  }


-- 2. Докажите, что множество подмножеств является инстансом SetSpec

\instance subsets {A : \Set} : SetSpec {A} (A -> \Prop)
  | isElem (a : A) (s : A -> \Prop) : \Prop => s a
  | set-ext {xs ys : A -> \Prop} (p : \Pi (a : A) -> xs a <-> ys a) : xs = ys =>
  \have
    q (a : A) : xs a = ys a => <->_=.1 (p a)
  \in ext q
  | empty : A -> \Prop => \lam a => Empty
  | empty-prop {a : A} : Not (empty a) => \lam e => e
  | add (a : A) (s : A -> \Prop) : A -> \Prop => \lam a1 => (a = a1) || s a1
  | add-head {x : A} {xs : A -> \Prop} : (add x xs) x => byLeft idp
  | add-tail {x y : A} {xs : A -> \Prop} (p : xs x) : (add y xs) x => byRight p
  | add-prop {x y : A} {xs : A -> \Prop} (p : (add x xs) y) : (x = y) || xs y => p

-- 3. Докажите, что множество подмножеств является наибольшим инстансом, то есть любой другой вкладывается в него

\func subsets-largest (S : SetSpec) : \Sigma (f : S -> S.A -> \Prop) (isInj f) => (
  isElem-func __ __,
  isElem= __
)
  \where {
    --     \func set-singleton (s : S) : S.A -> \Prop => \lam a => S.isElem a s

    \func isElem-func (s : S) : S.A -> \Prop => S.isElem __ s

    -- взаимно рекурсивные мб
    -- равенство пропов очев
    \func add-isElem= {s1 s2 : S} {a : S.A} (p : isElem-func s1 = isElem-func s2) : isElem-func (S.add a s1) = isElem-func (S.add a s2) =>
      ext (\lam _ => <->_=.1 (one-side p __, one-side (inv p) __))
      \where {
        \func one-side {s3 s4 : S} {a' : S.A} (q : isElem-func s3 = isElem-func s4) (r : isElem-func (S.add a s3) a') : isElem-func (S.add a s4) a' =>
          \case S.add-prop r \with {
            | byLeft a=a' => transport (S.isElem __ (S.add a s4)) a=a' S.add-head
            | byRight a_in_s3 => S.add-tail (transport id (unext q a') a_in_s3)
          }
      }

    \func isElem= {s1 s2 : S} (p : isElem-func s1 = isElem-func s2) : s1 = s2 => {?}
  }


-- 4. Определите функцию isEmpty для ArraySet и для произвольного конечного множества

\func isEmptyArraySet {A : \Set} (xs : ArraySet A) : Bool \elim xs
  | in~ a => \case a \with {
    | nil => true
    | a1 :: l => false
  }-- EqArray in~ x in~ y
  | ~-equiv x y r => cases (x arg addPath, y arg addPath) \with {
    | nil, _, nil, q => idp
    | nil, p, :: a1 l : DArray (A : Fin (suc n) -> \Type), q => \have
      | in : In a1 (:: a1 l) => inP (0, idp)
      | eq : y = (:: a1 l) => q
      | in' : In a1 y => transport (In a1 __) (inv eq) in
      \in \case not-truncPEmpty $ TruncP.map ((r a1).2 in') (
        \lam i => \case transport id (pmap Fin (pmap (\lam arr => DArray.len {arr}) p)) i.1 \with {}
                                                            ) \with {}
    | a1 :: l, p, nil, q => \have -- copy-pasted
      | in : In a1 (:: a1 l) => inP (0, idp)
      | eq : x = (:: a1 l) => p
      | in' : In a1 x => transport (In a1 __) (inv eq) in
                            \in \case not-truncPEmpty $ TruncP.map ((r a1).1 in') (
        \lam i => \case transport id (pmap Fin (pmap (\lam arr => DArray.len {arr}) q)) i.1 \with {}
      ) \with {}
    | a1 :: l, _, a2 :: l1, _ => idp
  }

\func arraySetEquiv {S : FinSetSpec} : Equiv {ArraySet S.A} {S} => equality=>equivalence arraySet=Set

\func isEmptySet {S : FinSetSpec} (s : S) : Bool => isEmptyArraySet (Retraction.sec {arraySetEquiv} s)


-- 5. Определите функцию union {A : \Set} : S -> S -> S для ArraySet и для произвольного S (удовлетворяющего FinSetSpec)

-- \func arrayUnion {A : \Set} (a b : ArraySet A) : ArraySet A \elim a, b
--   | in~ a, in~ a1 => in~ $ a ++ a1
--   | in~ a, ~-equiv x y r => mcases
--   | ~-equiv x y r, in~ a => {?}

\func arrayUnion {A : \Set} (a b : ArraySet A) : ArraySet A \elim a
  | in~ a => \case b \with {
    | in~ b => in~ $ a ++ b
    -- (in~ $ a ++ x) = (in~ $ a ++ y)
    | ~-equiv x y r => Quotient.~-equiv {Array A} {EqArray} (a ++ x) (a ++ y) (\lam c =>
        \have
          | one-side {x' y' : Array A} (r' : EqArray x' y') : In c (a ++ x') -> In c (a ++ y') =>
            \case __ \with {
              | inP (x_index, p) => \case ++.split-index x_index \with {  -- lol ++_index-right signature is inconsistent with ++_index-left
                | inl (j, i=left_j) => inP (++.index-left j, ++.++_index-left j *> (inv $ ++.++_index-left j) *> pmap ((a ++ x') __) (inv i=left_j) *> p)
                | inr (j, i=right_j) => TruncP.map ((r' c).1 (inP (j, (inv $ ++.++_index-right {A} {a} {x'} {j}) *> pmap ((a ++ x') __) (inv i=right_j) *> p)))
                    (\lam (y_index, q) => (++.index-right {A} {a} {y'} y_index, ++.++_index-right {A} {a} {y'} {y_index} *> q))
              }
            }
        \in
          (
            one-side r,
            one-side (sym-EqArray r)
          ))
  }
  | ~-equiv x y r => cases b \with {
    | in~ a => Quotient.~-equiv {Array A} {EqArray} (x ++ a) (y ++ a) (\lam c =>  -- copy-paste
        \have
          | one-side {x' y' : Array A} (r' : EqArray x' y') : In c (x' ++ a) -> In c (y' ++ a) =>
            \case __ \with {
              | inP (x_index, p) => \case ++.split-index x_index \with {
                | inl (j, i=left_j) => TruncP.map ((r' c).1 (inP (j, (inv $ ++.++_index-left j) *> pmap ((x' ++ a) __) (inv i=left_j) *> p)))
                    (\lam (y_index, q) => (++.index-left {A} {y'} {a} y_index, ++.++_index-left y_index *> q))
                | inr (j, i=right_j) => inP (++.index-right j, ++.++_index-right {A} {y'} {a} {j} *> (inv $ ++.++_index-right {A} {x'} {a} {j}) *> pmap ((x' ++ a) __) (inv i=right_j) *> p)
              }
            }
        \in
          (
            one-side r,
            one-side (sym-EqArray r)
          ))
  }

\func union {S : FinSetSpec} (a b : S) : S => arraySetEquiv (arrayUnion (Retraction.sec {arraySetEquiv} a) (Retraction.sec {arraySetEquiv} b))

-- 6. Определите функцию intersection {A : DecSet} : S -> S -> S для ArraySet и для произвольного S (удовлетворяющего FinSetSpec)

\func arrayIntersection {A : DecSet} (a b : ArraySet A) : ArraySet A \elim a, b
  | in~ a, in~ b => in~ $ keep (\lam a' => \case index-dec a a' \with {
    | inl index : Index a a' => yes $ inP index
    | inr notIndex => no (inP notIndex)
  }) a
  | in~ a, ~-equiv x y r => {?}
  | ~-equiv x y r, in~ a => {?}

\func intersection {S : FinSetSpec} (a b : S) : S => arraySetEquiv (arrayIntersection (Retraction.sec {arraySetEquiv} a) (Retraction.sec {arraySetEquiv} b))

-- 7. Мы не можем определить функцию size в общем случае, но мы можем определить предикат S -> Nat -> \Prop,
--    соответствующий \lam xs n => size xs <= n
--    a) Определите описанный предикат
--    b) Определите функцию size из лекции
--    c) Докажите, что size-le эквивалентно определению через size, если A -- разрешимо и S -- конечно

\func size-le {S : SetSpec} (s : S) (n : Nat) : \Prop => ∃ (f : Fin n -> \Sigma (a : S.A) (a S.`isElem` s)) (isSurj f)

-- \func count {A : DecSet} (l : Array A) : Nat => DArray.len {nub l}

\func sym-EqArray {A : \Set} {xs ys : Array A} (p : EqArray xs ys) : EqArray ys xs => \lam a => <->sym (p a)

\func nub-In-agnostic {A : DecSet} {l : Array A} : In (nub l) l => \lam a => {?} -- do we need it?

\func nub-EqArray {A : DecSet} {xs ys : Array A} (p : EqArray xs ys) : EqArray (nub xs) ys => \lam a => (
  {?},
  {?}
                                                                                                        )

\func nub-len<= {A : DecSet} {xs ys : Array A} (p : EqArray xs ys) : DArray.len {nub xs} NatSemiring.<= DArray.len {ys} => {?}

\func size {A : DecSet} {S : FinSetSpec {A}} (s : S) : Nat => \case Retraction.sec {arraySetEquiv} s \with {
  | in~ a => DArray.len {nub a}
  | ~-equiv x y r => \have
    | nub-eq : EqArray x (nub y) => sym-EqArray $ nub-EqArray (sym-EqArray r)
    | nub-eq' : EqArray y (nub x) => sym-EqArray (nub-EqArray r)
                     \in <=-antisymmetric (nub-len<= nub-eq) (nub-len<= nub-eq')
}

\func size=>size-le {A : DecSet} {S : FinSetSpec {A}} {n : Nat} (s : S) : size s NatSemiring.<= n = size-le s n =>
  <->_=.1 (
    \lam size<=n => {?},
    {?}
          )


